// Flux-rs bootstrap configuration (blueprint §9.6, §27.2.3).
//
// This is the original Flux module's conf/template.json, unchanged except for
// four forced differences, so both projects present users the same shape: five
// regional groups that the subscription fills, with PROXY as the menu over
// them.
//
//   * no "inbounds": Flux injects exactly two tproxy inbounds of its own into
//     an immutable per-generation copy, and a template inbound would compete
//     with them for the listener (blueprint §9.1);
//   * "experimental.clash_api" ships commented out rather than active: the
//     original's has no secret, and on Android every app can reach loopback
//     (§27.2.3, C10). The block itself is at the end of this file, with what
//     enabling it costs written next to it;
//   * no "log.output": the daemon captures the engine's stdout and stderr into
//     fluxd.log, so a second log file would split the same output in two
//     (§13.3);
//   * the IPv6 fakeip range is 2001:db8:f::/48, not the original's fc00::/18.
//     Flux bypasses all of fc00::/7 because ULA is private space that must go
//     direct, so a fakeip inside it would be sent direct and every IPv6 fakeip
//     connection would fail silently. `fluxd check` rejects that overlap
//     outright (blueprint D21, §9.0.1).
//
// The five regional groups ship empty, exactly as the original's do. Flux
// fills each from the subscription by the same region keys (blueprint §28.2),
// so a subscription update needs no manual merge. A group the provider has no
// node for — say US on an Asia-only plan — becomes DIRECT, and is therefore
// still selectable. Until there is at least one node, this file is a template
// rather than a configuration: Flux refuses to start the engine and says so,
// instead of handing sing-box a config it rejects outright.
//
// This file is yours. Replace it with any complete supported sing-box
// configuration, then run `fluxd check`. Flux never rewrites it.
{
  "log": {
    "level": "error",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns_proxy",
        "server": "1.1.1.1",
        "detour": "PROXY"
      },
      {
        "type": "https",
        "tag": "dns_direct",
        "server": "223.5.5.5"
      },
      {
        "type": "fakeip",
        "tag": "dns_fakeip",
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "2001:db8:f::/48"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "dns_direct"
      },
      {
        "clash_mode": "Global",
        "server": "dns_proxy"
      },
      {
        "rule_set": "cn",
        "server": "dns_direct"
      },
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "rule_set": "proxy",
        "server": "dns_fakeip"
      }
    ],
    "final": "dns_proxy",
    "strategy": "prefer_ipv4",
    "independent_cache": true
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "selector",
      "tag": "PROXY",
      "outbounds": [
        "HK",
        "TW",
        "JP",
        "SG",
        "US"
      ],
      "interrupt_exist_connections": true
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "outbounds": [
        "PROXY"
      ]
    },
    {
      "type": "selector",
      "tag": "HK",
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "TW",
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "JP",
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "SG",
      "outbounds": []
    },
    {
      "type": "selector",
      "tag": "US",
      "outbounds": []
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Direct",
        "outbound": "DIRECT"
      },
      {
        "clash_mode": "Global",
        "outbound": "GLOBAL"
      },
      {
        "rule_set": "cn",
        "outbound": "DIRECT"
      },
      {
        "rule_set": "cnip",
        "outbound": "DIRECT"
      },
      {
        "ip_is_private": true,
        "outbound": "DIRECT"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "proxy",
        "format": "binary",
        "url": "https://ghfast.top/https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/proxy.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "cn",
        "format": "binary",
        "url": "https://ghfast.top/https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cn.srs",
        "update_interval": "1d"
      },
      {
        "type": "remote",
        "tag": "cnip",
        "format": "binary",
        "url": "https://ghfast.top/https://github.com/DustinWin/ruleset_geodata/releases/download/sing-box-ruleset/cnip.srs",
        "update_interval": "1d"
      }
    ],
    "final": "PROXY",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns_direct"
    }
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true,
      "store_rdrc": true
    }

    // The original's control panel, kept here so nothing is hidden from you,
    // and inert until you uncomment it. It is the one thing Flux does not ship
    // enabled, for two reasons worth knowing before you turn it on:
    //
    //   * on Android 127.0.0.1 is not a trust boundary. Every app holding
    //     INTERNET can reach this port, so an empty "secret" lets any of them
    //     read your traffic stats and switch your outbound. Put a secret in
    //     before you enable it; `fluxd check` warns if it is empty.
    //   * "external_ui_download_url" makes the engine fetch a zip at run time
    //     and unpack it with no digest to verify it against, through the proxy
    //     itself. It lands next to this file's directory, in
    //     /data/adb/flux-rs/zashboard, because that is the engine's working
    //     directory. Downloading it yourself and pointing "external_ui" at it
    //     is the same panel without the unverified download.
    //
    // Fill in the secret, run `fluxd check`, then open this module's button in
    // your root manager: the page reads what you wrote here and navigates to
    // the panel.
    //
    // ,"clash_api": {
    //   "external_controller": "127.0.0.1:9090",
    //   "secret": "",
    //   "external_ui": "./zashboard",
    //   "external_ui_download_url": "https://github.com/Zephyruso/zashboard/releases/latest/download/dist.zip",
    //   "external_ui_download_detour": "PROXY",
    //   "default_mode": "Rule"
    // }
  }
}
