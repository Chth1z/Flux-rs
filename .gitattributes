# Auto detect text files and perform LF normalization. Check out as LF too:
# AGENTS.md promises "files are LF", and that promise should be kept by the
# repository, not by every machine's core.autocrlf.
* text=auto eol=lf

# Everything deployed to Android must be LF. module.prop in particular:
# the Magisk parser requires LF line endings (docs/blueprint.md §13.2.0).
*.sh text eol=lf
*.prop text eol=lf
module/** text eol=lf

# BPF source and the shared ABI header are consumed by clang on Linux.
bpf/**/*.c text eol=lf
bpf/**/*.h text eol=lf

# Lock files are compared byte for byte by reproducible packaging.
engine.lock text eol=lf
Cargo.lock text eol=lf
